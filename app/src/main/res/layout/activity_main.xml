<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:fitsSystemWindows="true"
    android:background="@color/bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Header -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="LAN Remote"
            android:textColor="@color/text_primary"
            android:textSize="28sp"
            android:textStyle="bold"
            android:letterSpacing="-0.02" />

        <TextView
            android:id="@+id/status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="● Idle"
            android:textColor="@color/idle"
            android:textSize="15sp"
            android:textStyle="bold" />

        <!-- Update banner (shown only when a newer GitHub release exists) -->
        <include
            android:id="@+id/updateBanner"
            layout="@layout/update_banner" />

        <!-- Control-disabled warning (shown only when the Accessibility service is off) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/controlWarn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:visibility="gone"
            app:cardBackgroundColor="#2A2410"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/warn"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="⚠ Remote control is off"
                    android:textColor="@color/warn"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="You'll see the screen but taps and typing won't work. Turn on the LAN Remote accessibility service to enable control."
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/enableControlBtn"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Enable control"
                    android:textColor="#1A1400"
                    android:textStyle="bold"
                    app:cornerRadius="12dp"
                    app:backgroundTint="@color/warn" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Connection card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/connectionCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            app:cardBackgroundColor="@color/card"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/card_stroke"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:padding="20dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="OPEN IN A BROWSER ON THE SAME NETWORK"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.08" />

                <TextView
                    android:id="@+id/url"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="—"
                    android:textColor="@color/accent_soft"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:fontFamily="monospace"
                    android:autoLink="none" />

                <TextView
                    android:id="@+id/warn"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textColor="@color/warn"
                    android:textSize="13sp"
                    android:visibility="gone" />

                <ImageView
                    android:id="@+id/qr"
                    android:layout_width="200dp"
                    android:layout_height="200dp"
                    android:layout_marginTop="18dp"
                    android:background="#FFFFFF"
                    android:padding="8dp"
                    android:visibility="gone"
                    android:contentDescription="Connection QR code" />

                <TextView
                    android:id="@+id/qrHint"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Scan to connect"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    android:visibility="gone" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/shareBtn"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Share link"
                    android:textColor="@color/text_primary"
                    android:textStyle="bold"
                    android:visibility="gone"
                    app:cornerRadius="12dp"
                    app:backgroundTint="@color/card_stroke"
                    app:icon="@android:drawable/ic_menu_share"
                    app:iconTint="@color/accent_soft" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Stats card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/statsCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:alpha="0.5"
            app:cardBackgroundColor="@color/card"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/card_stroke"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="SESSION"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.08" />

                <!-- rows added programmatically-friendly: label + value -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:layout_marginTop="14dp">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                        android:text="Viewer" android:textColor="@color/text_secondary" android:textSize="15sp" />
                    <TextView android:id="@+id/statViewer" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="—" android:textColor="@color/text_primary" android:textSize="15sp" android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:layout_marginTop="10dp">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                        android:text="Video" android:textColor="@color/text_secondary" android:textSize="15sp" />
                    <TextView android:id="@+id/statVideo" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="—" android:textColor="@color/text_primary" android:textSize="15sp" android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:layout_marginTop="10dp">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                        android:text="Frame rate" android:textColor="@color/text_secondary" android:textSize="15sp" />
                    <TextView android:id="@+id/statFps" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="—" android:textColor="@color/text_primary" android:textSize="15sp" android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:layout_marginTop="10dp">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                        android:text="Bitrate" android:textColor="@color/text_secondary" android:textSize="15sp" />
                    <TextView android:id="@+id/statBitrate" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="—" android:textColor="@color/text_primary" android:textSize="15sp" android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:layout_marginTop="10dp">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                        android:text="Audio" android:textColor="@color/text_secondary" android:textSize="15sp" />
                    <TextView android:id="@+id/statAudio" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="—" android:textColor="@color/text_primary" android:textSize="15sp" android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:layout_marginTop="10dp">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                        android:text="Data sent" android:textColor="@color/text_secondary" android:textSize="15sp" />
                    <TextView android:id="@+id/statData" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="—" android:textColor="@color/text_primary" android:textSize="15sp" android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Stream quality card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/qualityCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            app:cardBackgroundColor="@color/card"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/card_stroke"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="STREAM QUALITY"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.08" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Resolution"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp" />

                <com.google.android.material.button.MaterialButtonToggleGroup
                    android:id="@+id/scaleGroup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    app:singleSelection="true"
                    app:selectionRequired="true">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/scale100"
                        android:text="100%"
                        style="?attr/materialButtonOutlinedStyle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:paddingStart="0dp"
                        android:paddingEnd="0dp"
                        android:paddingLeft="0dp"
                        android:paddingRight="0dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:minWidth="0dp"
                        android:maxLines="1"
                        android:ellipsize="none"
                        android:textSize="14sp"
                        android:textColor="@color/scale_button_text"
                        android:textStyle="bold"
                        app:iconPadding="0dp"
                        app:backgroundTint="@color/scale_button_bg"
                        app:strokeColor="@color/card_stroke" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/scale75"
                        android:text="75%"
                        style="?attr/materialButtonOutlinedStyle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:paddingStart="0dp"
                        android:paddingEnd="0dp"
                        android:paddingLeft="0dp"
                        android:paddingRight="0dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:minWidth="0dp"
                        android:maxLines="1"
                        android:ellipsize="none"
                        android:textSize="14sp"
                        android:textColor="@color/scale_button_text"
                        android:textStyle="bold"
                        app:iconPadding="0dp"
                        app:backgroundTint="@color/scale_button_bg"
                        app:strokeColor="@color/card_stroke" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/scale50"
                        android:text="50%"
                        style="?attr/materialButtonOutlinedStyle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:paddingStart="0dp"
                        android:paddingEnd="0dp"
                        android:paddingLeft="0dp"
                        android:paddingRight="0dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:minWidth="0dp"
                        android:maxLines="1"
                        android:ellipsize="none"
                        android:textSize="14sp"
                        android:textColor="@color/scale_button_text"
                        android:textStyle="bold"
                        app:iconPadding="0dp"
                        app:backgroundTint="@color/scale_button_bg"
                        app:strokeColor="@color/card_stroke" />
                </com.google.android.material.button.MaterialButtonToggleGroup>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="Frame rate"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp" />

                <com.google.android.material.button.MaterialButtonToggleGroup
                    android:id="@+id/fpsGroup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    app:singleSelection="true"
                    app:selectionRequired="true">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/fps15"
                        android:text="15 fps"
                        style="?attr/materialButtonOutlinedStyle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:paddingStart="0dp"
                        android:paddingEnd="0dp"
                        android:paddingLeft="0dp"
                        android:paddingRight="0dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:minWidth="0dp"
                        android:maxLines="1"
                        android:ellipsize="none"
                        android:textSize="14sp"
                        android:textColor="@color/scale_button_text"
                        android:textStyle="bold"
                        app:iconPadding="0dp"
                        app:backgroundTint="@color/scale_button_bg"
                        app:strokeColor="@color/card_stroke" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/fps30"
                        android:text="30 fps"
                        style="?attr/materialButtonOutlinedStyle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:paddingStart="0dp"
                        android:paddingEnd="0dp"
                        android:paddingLeft="0dp"
                        android:paddingRight="0dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:minWidth="0dp"
                        android:maxLines="1"
                        android:ellipsize="none"
                        android:textSize="14sp"
                        android:textColor="@color/scale_button_text"
                        android:textStyle="bold"
                        app:iconPadding="0dp"
                        app:backgroundTint="@color/scale_button_bg"
                        app:strokeColor="@color/card_stroke" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/fps60"
                        android:text="60 fps"
                        style="?attr/materialButtonOutlinedStyle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:paddingStart="0dp"
                        android:paddingEnd="0dp"
                        android:paddingLeft="0dp"
                        android:paddingRight="0dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:minWidth="0dp"
                        android:maxLines="1"
                        android:ellipsize="none"
                        android:textSize="14sp"
                        android:textColor="@color/scale_button_text"
                        android:textStyle="bold"
                        app:iconPadding="0dp"
                        app:backgroundTint="@color/scale_button_bg"
                        app:strokeColor="@color/card_stroke" />
                </com.google.android.material.button.MaterialButtonToggleGroup>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="JPEG quality (MJPEG mode only)"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp" />

                <com.google.android.material.button.MaterialButtonToggleGroup
                    android:id="@+id/jpegGroup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    app:singleSelection="true"
                    app:selectionRequired="true">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/jpegLow"
                        android:text="Low"
                        style="?attr/materialButtonOutlinedStyle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:paddingStart="0dp"
                        android:paddingEnd="0dp"
                        android:paddingLeft="0dp"
                        android:paddingRight="0dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:minWidth="0dp"
                        android:maxLines="1"
                        android:ellipsize="none"
                        android:textSize="14sp"
                        android:textColor="@color/scale_button_text"
                        android:textStyle="bold"
                        app:iconPadding="0dp"
                        app:backgroundTint="@color/scale_button_bg"
                        app:strokeColor="@color/card_stroke" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/jpegMed"
                        android:text="Med"
                        style="?attr/materialButtonOutlinedStyle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:paddingStart="0dp"
                        android:paddingEnd="0dp"
                        android:paddingLeft="0dp"
                        android:paddingRight="0dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:minWidth="0dp"
                        android:maxLines="1"
                        android:ellipsize="none"
                        android:textSize="14sp"
                        android:textColor="@color/scale_button_text"
                        android:textStyle="bold"
                        app:iconPadding="0dp"
                        app:backgroundTint="@color/scale_button_bg"
                        app:strokeColor="@color/card_stroke" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/jpegHigh"
                        android:text="High"
                        style="?attr/materialButtonOutlinedStyle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:paddingStart="0dp"
                        android:paddingEnd="0dp"
                        android:paddingLeft="0dp"
                        android:paddingRight="0dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:minWidth="0dp"
                        android:maxLines="1"
                        android:ellipsize="none"
                        android:textSize="14sp"
                        android:textColor="@color/scale_button_text"
                        android:textStyle="bold"
                        app:iconPadding="0dp"
                        app:backgroundTint="@color/scale_button_bg"
                        app:strokeColor="@color/card_stroke" />
                </com.google.android.material.button.MaterialButtonToggleGroup>

                <TextView
                    android:id="@+id/scaleHint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Changes apply live, even while sharing. Lower values use less bandwidth and CPU."
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Action button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/toggle"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="22dp"
            android:text="Start sharing"
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            app:cornerRadius="16dp"
            app:backgroundTint="@color/accent" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="8dp"
            android:text="No password — anyone on this network can connect while sharing. Use trusted networks only."
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:gravity="center" />
    </LinearLayout>
</ScrollView>
