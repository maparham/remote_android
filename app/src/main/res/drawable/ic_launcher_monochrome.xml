<?xml version="1.0" encoding="utf-8"?>
<!-- Monochrome layer for Android 13+ themed icons: the artwork only, no disc.
     The launcher tints this by alpha, so a filled disc here would hide the art. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Centre the artwork on the disc and scale it to sit comfortably inside -->
    <group android:translateX="-2" android:translateY="2"
        android:pivotX="54" android:pivotY="54"
        android:scaleX="0.9" android:scaleY="0.9">
        <!-- Phone body (outline) -->
        <path
            android:pathData="M41,38 h14 a5,5 0 0 1 5,5 v34 a5,5 0 0 1 -5,5 h-14 a5,5 0 0 1 -5,-5 v-34 a5,5 0 0 1 5,-5 z"
            android:strokeColor="#FFFFFFFF"
            android:strokeWidth="3.5"
            android:strokeLineJoin="round"
            android:fillColor="#00000000" />

        <!-- Home indicator -->
        <path
            android:pathData="M44.5,76 L51.5,76"
            android:strokeColor="#FFFFFFFF"
            android:strokeWidth="2"
            android:strokeLineCap="round"
            android:fillColor="#00000000" />

        <!-- Pointer cursor on the screen -->
        <path
            android:pathData="M43.5,50 v15.5 l3.9,-3.4 l2.6,5.9 l2.9,-1.3 l-2.6,-5.9 l5.2,-0.4 z"
            android:fillColor="#FFFFFFFF"
            android:strokeColor="#FFFFFFFF"
            android:strokeWidth="0.8"
            android:strokeLineJoin="round" />

        <!-- Signal arcs from the phone's top-right corner -->
        <path
            android:pathData="M66,38 A6,6 0 0 0 60,32"
            android:strokeColor="#FFA99BFF"
            android:strokeWidth="3"
            android:strokeLineCap="round"
            android:fillColor="#00000000" />
        <path
            android:pathData="M71.5,38 A11.5,11.5 0 0 0 60,26.5"
            android:strokeColor="#FFA99BFF"
            android:strokeWidth="3"
            android:strokeLineCap="round"
            android:fillColor="#00000000" />
        <path
            android:pathData="M77,38 A17,17 0 0 0 60,21"
            android:strokeColor="#FFA99BFF"
            android:strokeWidth="3"
            android:strokeLineCap="round"
            android:fillColor="#00000000" />
    </group>
</vector>
